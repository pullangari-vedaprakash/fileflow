# PostgreSQL Database Connection
# Local Docker: postgresql+asyncpg://fileflow:fileflow123@localhost:5432/fileflow
# Cloud (e.g. Neon): postgresql://user:password@ep-xyz.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+asyncpg://fileflow:fileflow123@localhost:5432/fileflow

# Redis Connection (Queue & Pub/Sub)
# Local Docker: redis://localhost:6379/0
# Cloud (e.g. Upstash): rediss://default:password@xyz.upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# Object Storage (S3 / MinIO / Cloudflare R2)
# Local MinIO: localhost:9000
# Cloudflare R2: <account_id>.r2.cloudflarestorage.com
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=fileflow
MINIO_SECURE=false

# Authentication
JWT_SECRET=replace-this-with-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
